@{
ViewData["Title"] = "Event Management & Booking System";
Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Header Section -->
<div class="header-section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1 class="display-4">Event Management & Booking System</h1>
                <p class="lead">Book, Manage, and Enjoy Your Events</p>
            </div>
        </div>
    </div>
</div>

<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <h2 class="display-2">Book Your Events</h2>
                <p class="lead">With our easy-to-use booking system, you can manage your events with ease.</p>
                <button class="btn btn-primary">Get Started</button>
            </div>
            <div class="col-md-6">
                <img src="~/images/event-management.jpg" alt="Event Management" class="img-fluid">
            </div>
        </div>
    </div>
</div>

<!-- Call to Action Section -->
<div class="call-to-action-section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="display-3">Need Help?</h3>
                <p class="lead">Get in touch with us and we'll be happy to assist you.</p>
                <button class="btn btn-secondary">Contact Us</button>
            </div>
        </div>
    </div>
</div>

